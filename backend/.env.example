# Port for the backend server
PORT=3001

# Redis connection details for BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Supabase credentials for backend access
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Ethereal account for Nodemailer (for testing emails)
# Get credentials from https://ethereal.email/
ETHEREAL_USER=
ETHEREAL_PASS=

# Slack Bot Token
# SLACK_BOT_TOKEN=

# Stripe API Keys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
